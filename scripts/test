#!/bin/bash

set -euo pipefail

REPO_ROOT="$(dirname ${BASH_SOURCE[0]})/.."
cd ${REPO_ROOT}

TARGET="${1:?usage: scripts/test <esp32|offline>}"

case ${TARGET} in
  esp32)
    pio run --environment test-e2e-esp32 --target upload
    pio run --environment test-e2e-ota-esp32
    cd e2e-tests
    uv run pytest -m esp32
    ;;
  offline)
    pio run
    cd e2e-tests
    uv run pytest -m offline
    ;;
  *)
    echo "unknown target: ${TARGET}" >&2
    exit 1
    ;;
esac
